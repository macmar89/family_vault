generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id       String   @id @default(cuid(2))
  email    String   @unique
  password String
  name     String?
  role     UserRole

  tokenVersion Int       @default(1)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  vaultItems       VaultItem[]
  refreshTokens    RefreshToken[]
  vaultPermissions VaultPermission[]
  auditLogs        AuditLog[]
}

enum ItemType {
  BANK_ACCOUNT
  LOGIN
  INSURANCE
  OTHER
  SECURE_NOTE
  CREDIT_CARD
  IDENTITY_DOCUMENT
  CRYPTO_WALLET
  SOFTWARE_LICENSE
  WARRANTY
}

model VaultItem {
  id    String   @id @default(cuid(2))
  type  ItemType
  title String

  encryptedData String

  amount        Float?
  frequencyDays Int?
  nextPaymentAt DateTime?

  ownerId   String
  user      User      @relation(fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  attachments      FileAttachment[]
  vaultPermissions VaultPermission[]

  @@index([ownerId])
  @@index([nextPaymentAt])
  @@index([ownerId, type])
}

model VaultPermission {
  id          String  @id @default(cuid(2))
  vaultItemId String
  userId      String
  canEdit     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vaultItemId, userId])
}

model FileAttachment {
  id String @id @default(cuid(2))

  originalName String
  mimeType     String
  path         String
  sizeBytes    Int

  vaultItemId String
  vaultItem   VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([vaultItemId])
}

model RefreshToken {
  id        String   @id @default(cuid(2))
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?  @db.VarChar(45)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT

  VAULT_ITEM_CREATE
  VAULT_ITEM_READ
  VAULT_ITEM_DECRYPT
  VAULT_ITEM_UPDATE
  VAULT_ITEM_DELETE

  PERMISSION_GRANT
  PERMISSION_REVOKE
}

enum EntityType {
  USER
  AUTH
  VAULT_ITEM
}

model AuditLog {
  id String @id @default(cuid(2))

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action     AuditAction
  entityType EntityType
  entityId   String?

  metadata Json?

  ipAddress String? @db.VarChar(45)
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId])
}
